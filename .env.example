# ==============================================================================
# LEDGERGUARD AI — CONFIGURATION TEMPLATE
# Copy to .env and configure with production credentials
# ==============================================================================

# Core System
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
SECRET_KEY=generate_a_secure_64_character_hex_string_for_production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000

# AI Inference Engines (Dual-Engine: Groq ultra-fast + Gemini deep reasoning)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Security Defenses & Rate Limiting
MAX_UPLOAD_SIZE_MB=10
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=15
MAX_PDF_PAGES=20
MAX_TEXT_CHARACTERS=200000

# Stripe Monetization (Optional - operates in simulated mode if omitted)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PRICE_ID_PRO=price_your_pro_tier_id
STRIPE_PRICE_ID_ENTERPRISE=price_your_enterprise_tier_id

# Database
DATABASE_URL=sqlite:///./data/ledgerguard.db
